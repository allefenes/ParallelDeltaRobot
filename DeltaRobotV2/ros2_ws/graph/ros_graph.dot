digraph ros_graph {
  rankdir=LR;
  graph [fontname="DejaVu Sans", fontsize=11, nodesep=0.35, ranksep=0.8, label="Delta Robotics V2 ROS2 grafiği (servis: kesikli)", labelloc=t];
  node [fontname="DejaVu Sans", fontsize=11];
  edge [fontname="DejaVu Sans", fontsize=9];
  n_delta_state_publisher [label="/delta_state_publisher", shape=ellipse];
  n_edge_bridge [label="/edge_bridge", shape=ellipse];
  n_robot_state_publisher [label="/robot_state_publisher", shape=ellipse];
  n_supervisor [label="/supervisor", shape=ellipse];
  n_trajectory_planner [label="/trajectory_planner", shape=ellipse];
  t_delta_markers [label="/delta/markers\n2 Hz", shape=box];
  t_edge_connected [label="/edge/connected", shape=box];
  t_edge_status [label="/edge/status\n18.1 Hz", shape=box];
  t_edge_trajectory_out [label="/edge/trajectory_out", shape=box];
  t_joint_states [label="/joint_states\n18.1 Hz", shape=box];
  t_robot_description [label="/robot_description", shape=box];
  t_supervisor_events [label="/supervisor/events", shape=box];
  t_tf [label="/tf\n34 Hz", shape=box];
  t_tf_static [label="/tf_static", shape=box];
  s_edge_bridge_heartbeat_pause [label="/edge_bridge/heartbeat_pause", shape=box, style="rounded,dashed"];
  s_edge_bridge_torque [label="/edge_bridge/torque", shape=box, style="rounded,dashed"];
  s_move_to [label="/move_to", shape=box, style="rounded,dashed"];
  s_supervisor_validate [label="/supervisor/validate", shape=box, style="rounded,dashed"];
  n_delta_state_publisher -> t_delta_markers;
  n_edge_bridge -> t_edge_connected;
  n_edge_bridge -> t_edge_status;
  t_edge_status -> n_supervisor;
  n_supervisor -> t_edge_trajectory_out;
  t_edge_trajectory_out -> n_edge_bridge;
  n_edge_bridge -> t_joint_states;
  t_joint_states -> n_delta_state_publisher;
  t_joint_states -> n_robot_state_publisher;
  t_joint_states -> n_supervisor;
  t_joint_states -> n_trajectory_planner;
  n_robot_state_publisher -> t_robot_description;
  n_edge_bridge -> t_supervisor_events;
  n_supervisor -> t_supervisor_events;
  t_supervisor_events -> n_delta_state_publisher;
  n_delta_state_publisher -> t_tf;
  n_robot_state_publisher -> t_tf;
  n_robot_state_publisher -> t_tf_static;
  s_edge_bridge_heartbeat_pause -> n_edge_bridge [style=dashed];
  s_edge_bridge_torque -> n_edge_bridge [style=dashed];
  s_move_to -> n_trajectory_planner [style=dashed];
  n_trajectory_planner -> s_supervisor_validate [style=dashed];
  s_supervisor_validate -> n_supervisor [style=dashed];
  delta_edge [label="delta_edge\n(Raspberry Pi)", shape=box3d];
  n_edge_bridge -> delta_edge [label="TLS WebSocket,\nPi bağlanır", dir=both, style=bold];
}
